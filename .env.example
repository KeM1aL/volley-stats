NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email Template Deployment
# Project Reference ID (found in project URL: https://supabase.com/dashboard/project/{PROJECT_REF})
SUPABASE_PROJECT_REF=

# Personal Access Token (generate at: https://supabase.com/dashboard/account/tokens)
# Required for deploying email templates to production via npm run email:deploy
SUPABASE_ACCESS_TOKEN=

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXX
NEXT_PUBLIC_GTM_MEASUREMENT_ID=GTM-XXXXXX

RESEND_API_KEY=
# Origin of the web deployment hosting /api/v1 (report PDF, FFVB import). Required by the static export (BUILD_TARGET=mobile) at build time.
NEXT_PUBLIC_API_ORIGIN=
# Origin the web deployment serves the app from (links in e-mails and shared URLs). Required by the static export at build time.
NEXT_PUBLIC_WEB_ORIGIN=

# Comma-separated origins allowed to call /api/v1 (e2e export: http://localhost:3200; the app: capacitor://localhost,https://localhost)
API_CORS_ORIGINS=
