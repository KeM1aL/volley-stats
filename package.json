    "email:dev": "email dev --dir emails",
    "email:build": "email export --outDir supabase/templates/auth --dir emails",
    "email:preview": "email dev --port 3001 --dir emails",
    "email:deploy": "tsx scripts/deploy-email-templates.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint:report": "eslint . --format json --output-file test-results/lint.json || exit 0"
