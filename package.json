  "scripts": {
    "dev": "next dev --webpack",
    "dev:inspect": "next dev --inspect=0.0.0.0",
    "build": "next build --webpack",
    "start": "next start",
    "start:inspect": "next start --inspect=0.0.0.0",
    "lint": "eslint .",
    "i18n:check": "i18n-check -s en --locales messages",
    "supabase:types": "npx supabase gen types typescript --project-id gvtjccisbwrwpjtabnyd --schema public > lib/supabase/database.types.ts",
    "supabase:functions:deploy:send-email": "npx supabase functions deploy send-email --no-verify-jwt --project-ref 'gvtjccisbwrwpjtabnyd'",
